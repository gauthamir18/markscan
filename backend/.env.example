DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME

# --- Vision AI Tier 1: Google Gemini API (Primary, Fast Cloud Vision) ---
VISION_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=30

# --- Vision AI Tier 2: Qwen 2.5-VL (Local Fallback via Ollama / LM Studio) ---
QWEN_BASE_URL=http://localhost:11434
QWEN_MODEL=qwen2.5vl:3b
QWEN_TIMEOUT=60

# --- Tier 3: Local Offline Model (CRNN PyTorch / EasyOCR) activates automatically if Tiers 1 & 2 fail ---

# Google Drive Storage Configuration
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id
GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=service_account.json

# Required: generate a unique random secret (e.g. python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
